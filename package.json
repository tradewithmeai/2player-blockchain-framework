{
  "name": "2player-blockchain-framework",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:testnet": "anchor deploy --provider.cluster testnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "dev:web": "yarn workspace @skill-gaming/web dev",
    "dev:server": "yarn workspace @skill-gaming/server dev",
    "build:web": "yarn workspace @skill-gaming/web build",
    "build:server": "yarn workspace @skill-gaming/server build"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "chai": "^4.4.1",
    "mocha": "^10.2.0",
    "prettier": "^3.1.1",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.1",
    "@solana/web3.js": "^1.91.4",
    "bn.js": "^5.2.1"
  }
}
