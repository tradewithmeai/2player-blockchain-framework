# Server
PORT=3001
NODE_ENV=development

# Database (Neon Postgres recommended)
DATABASE_URL="postgresql://user:password@host:5432/skillgaming?sslmode=require"

# Solana
RPC_ENDPOINT="https://api.devnet.solana.com"
WSS_ENDPOINT="wss://api.devnet.solana.com"
CLUSTER=devnet

# Programs (update after deployment)
SKILL_TREASURY_PROGRAM_ID="SkTry9999999999999999999999999999999999999"
SKILL_ESCROW_PROGRAM_ID="SkEsc9999999999999999999999999999999999999"
TTT_ONCHAIN_PROGRAM_ID="TicTa9999999999999999999999999999999999999"
SKILL_MINT="YourSkillMintAddress"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Session
SESSION_SECRET="your-secret-key-here-change-in-production"
